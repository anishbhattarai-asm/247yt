# systemd unit for the stream panel. install-units.sh fills in __USER__,
# __DIR__ and __NODE__ and installs it as /etc/systemd/system/stream-panel.service.
#
# Layer 1 of self-healing: systemd keeps server.js alive (crash or reboot).
# Layer 2 is in the app: the supervisor keeps FFmpeg and the stream alive.

[Unit]
Description=Stream Panel (24/7 YouTube streaming)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__DIR__
ExecStart=__NODE__ __DIR__/server.js
Environment=NODE_ENV=production
Restart=always
RestartSec=5
# SIGTERM: the app flushes the stream cleanly and keeps "should be streaming",
# so it resumes on the next start. Give it time to do that.
KillSignal=SIGTERM
TimeoutStopSec=30
LimitNOFILE=65536

# Hardening: the panel writes only its settings (data/) and videos (media/).
# Its own code, deploy/ scripts and the terminal's session program are
# read-only to it, so a bug in the panel (or in FFmpeg reading a video)
# can't plant code that runs later outside this sandbox.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=__DIR__/data __DIR__/media

[Install]
WantedBy=multi-user.target
